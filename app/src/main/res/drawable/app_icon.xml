<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00695C" />
        </shape>
    </item>
    <item android:insetLeft="12dp" android:insetTop="12dp"
        android:insetRight="12dp" android:insetBottom="12dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:insetLeft="20dp" android:insetTop="20dp"
        android:insetRight="20dp" android:insetBottom="20dp">
        <shape android:shape="oval">
            <solid android:color="#263238" />
        </shape>
    </item>
</layer-list>
